{
  "name": "whiskers",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Whiskers — juego cozy en pixel art isométrico: cuida a los gatos y perros callejeros del barrio.",
  "scripts": {
    "art": "tsx scripts/build-art.ts",
    "dev": "npm run art && vite",
    "build": "npm run art && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "shots": "tsx scripts/shots.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0"
  }
}
